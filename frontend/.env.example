# GrandMate v2 frontend configuration
#
# Copy to `.env` and adjust. Only VITE_-prefixed variables reach the browser.
#
# Nothing secret belongs in this file. MVP login is username-claim (ADR-0014, deferring
# ADR-0007's Lichess OAuth2 PKCE), so there is no OAuth client id or redirect URI yet.

VITE_API_BASE_URL=http://localhost:7575
