# GrandMate v2 frontend configuration
#
# Copy to `.env` and adjust. Only VITE_-prefixed variables reach the browser.
#
# Nothing secret belongs in this file. Every value here is public by construction: the
# Lichess client id is public by design (ADR-0007 — Lichess is a public OAuth client with
# no secret). Anything that needs protecting lives behind the backend.

VITE_API_BASE_URL=http://localhost:7575
VITE_LICHESS_CLIENT_ID=grandmate-v2
VITE_LICHESS_REDIRECT_URI=http://localhost:3535/auth/callback
