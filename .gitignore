# Secrets — never commit. Only .env.example belongs in git.
.env
.env.*
!.env.example

# Python
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
coverage.xml
htmlcov/
*.egg-info/
dist/
build/
# Exception: dist/ above is meant for Python package build output, but it also matches
# backend/data/openings/dist/ — the *committed*, vendored-and-regenerated Lichess opening
# TSVs that domain/patterns actually loads at runtime (see PROVENANCE.md). Not a build
# artifact; must stay tracked.
!backend/data/openings/dist/
!backend/data/openings/dist/*.tsv

# Node
node_modules/
frontend/dist/
coverage/
*.tsbuildinfo
.vite/

# Editors / OS
.DS_Store
.idea/
.vscode/
*.swp

# Local tooling
.claude/settings.local.json

# Local dev storage — uploaded PGNs, generated reports (StorageBackend local adapter,
# ADR-0015). Path matches STORAGE_LOCAL_PATH in backend/.env.example.
backend/.storage/
