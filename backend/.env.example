# GrandMate v2 backend configuration
#
# Copy to `.env` and fill in the blanks. `.env` is gitignored and must never be committed.
# Every value here is read through app/core/config — nothing is hardcoded in application
# code. See final_docs/v2/configuration.md for the full contract.
#
# Secrets are left BLANK on purpose. Do not commit real values to this file.

# ---------------------------------------------------------------------------
# Application
# ---------------------------------------------------------------------------
APP_ENV=development
LOG_LEVEL=INFO
API_PORT=7575
CORS_ALLOWED_ORIGINS=http://localhost:3535

# ---------------------------------------------------------------------------
# Supabase (Phase 2 — owner supplies local project details)
# ---------------------------------------------------------------------------
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
DATABASE_URL=

# ---------------------------------------------------------------------------
# Identity — Lichess OAuth2 PKCE (ADR-0007)
# Lichess is a public OAuth client: no client secret exists, and the client id is a
# self-chosen constant. Only SESSION_JWT_SECRET is sensitive here.
# ---------------------------------------------------------------------------
LICHESS_CLIENT_ID=grandmate-v2
LICHESS_REDIRECT_URI=http://localhost:3535/auth/callback
LICHESS_SCOPES=email:read,preference:read
SESSION_JWT_SECRET=
SESSION_TTL_SECONDS=604800

# ---------------------------------------------------------------------------
# Engine — Stockfish (ADR-0004)
# ENGINE_THREADS is 1 deliberately. Multi-threaded Stockfish is not reproducible across
# runs, and Phase 5 requires identical classifications on repeated runs. Parallelism
# comes from running several games at once, not several threads per position.
# ---------------------------------------------------------------------------
STOCKFISH_PATH=/usr/local/bin/stockfish
ENGINE_DEPTH=12
ENGINE_DEEP_DEPTH=18
ENGINE_THREADS=1
ENGINE_HASH_MB=128
ENGINE_TIMEOUT_S=30

# Move classification thresholds, in centipawns.
INACCURACY_CP=50
MISTAKE_CP=100
BLUNDER_CP=300
# Eval swing above which a position is re-analysed at ENGINE_DEEP_DEPTH.
CRITICAL_SWING_CP=150

# ---------------------------------------------------------------------------
# LLM (ADR-0006)
# ---------------------------------------------------------------------------
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o-mini
OPENAI_API_KEY=
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=2000
LLM_REQUEST_TIMEOUT_S=60
# Hard daily ceiling. Leave blank for no ceiling. Owner decision pending (Q-4).
LLM_DAILY_TOKEN_CEILING=

# ---------------------------------------------------------------------------
# Retrieval (Phase 7, ADR-0008)
# ---------------------------------------------------------------------------
EMBED_MODEL=text-embedding-3-small
EMBED_DIMENSIONS=1536
CHUNK_SIZE_TOKENS=512
CHUNK_OVERLAP_TOKENS=64
RETRIEVAL_TOP_K=8
RETRIEVAL_FUSION_K=60
RETRIEVAL_MIN_SCORE=0.0

# ---------------------------------------------------------------------------
# Agents (Phase 10+). Ceilings are hard limits.
# ---------------------------------------------------------------------------
AGENT_MAX_STEPS=8
AGENT_MAX_TOOL_CALLS=12
AGENT_TOKEN_BUDGET=20000

# ---------------------------------------------------------------------------
# Ingestion
# ---------------------------------------------------------------------------
MAX_PGN_UPLOAD_MB=10
MAX_GAMES_PER_IMPORT=60
LICHESS_RATE_LIMIT_RPS=1.0
CHESSCOM_RATE_LIMIT_RPS=1.0

# ---------------------------------------------------------------------------
# Developer insight tracing (ADR-0013)
#
# Records request traces in an in-memory ring buffer, read via /api/v1/dev/traces.
# Recording never calls a model and never runs a tokenizer — token counts come from the
# provider's own response. Cost is a list append per span.
#
# Both switches are forced OFF in production regardless of what is set here: the routes
# are unauthenticated until Phase 2, and prompt text can contain a user's game history.
# ---------------------------------------------------------------------------
DEV_INSIGHT_ENABLED=true
# Captures prompt and retrieved-context TEXT. Off by default everywhere. Turn on only
# when actively debugging prompt construction locally.
DEV_INSIGHT_CAPTURE_PROMPTS=false
DEV_INSIGHT_MAX_TRACES=50
DEV_INSIGHT_MAX_SPANS_PER_TRACE=200

# ---------------------------------------------------------------------------
# Evaluation thresholds (see final_docs/v2/evaluation-strategy.md)
# ---------------------------------------------------------------------------
RAGAS_FAITHFULNESS_THRESHOLD=0.85
RAGAS_ANSWER_ACCURACY_THRESHOLD=0.80
RAGAS_CONTEXT_PRECISION_THRESHOLD=0.75
RAGAS_CONTEXT_RECALL_THRESHOLD=0.75
EVAL_RUN_DIR=evals/runs
