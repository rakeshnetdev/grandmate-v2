# GrandMate v2 backend configuration
#
# Copy to `.env` and fill in the blanks. `.env` is gitignored and must never be committed.
# Every value here is read through app/core/config — nothing is hardcoded in application
# code. See final_docs/v2/configuration.md for the full contract.
#
# Secrets are left BLANK on purpose. Do not commit real values to this file.

# ---------------------------------------------------------------------------
# Application
# ---------------------------------------------------------------------------
APP_ENV=development
LOG_LEVEL=INFO
# Bind address used by `uv run python -m app`. Containers override this to 0.0.0.0.
API_HOST=127.0.0.1
API_PORT=7575
CORS_ALLOWED_ORIGINS=http://localhost:3535

# ---------------------------------------------------------------------------
# Database — plain Postgres 17 with pgvector (ADR-0015)
#
# Start it with:  docker compose up -d postgres
#
# Port 5433, not 5432, so a developer's existing local Postgres keeps the standard
# port. Supabase is deferred to Phase 17; because Supabase is Postgres, adopting it
# later changes this URL and nothing else.
#
# A blank value here falls back to the same default rather than producing an empty
# connection string.
# ---------------------------------------------------------------------------
DATABASE_URL=postgresql+asyncpg://grandmate:grandmate@localhost:5433/grandmate
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_ECHO_SQL=false

# ---------------------------------------------------------------------------
# Storage — uploaded PGNs and generated reports (ADR-0015)
#
# Filesystem for MVP, behind a StorageBackend interface. Swapping to S3, R2, or
# Supabase Storage later means writing one adapter, not changing calling code.
# ---------------------------------------------------------------------------
STORAGE_BACKEND=local
STORAGE_LOCAL_PATH=.storage

# ---------------------------------------------------------------------------
# Identity — simple username-claim login for MVP (ADR-0014, deferring ADR-0007's
# real Lichess OAuth2 PKCE). Login checks a username exists on Lichess or Chess.com via
# each platform's public API and issues a session for it — no proof of ownership yet.
# SESSION_JWT_SECRET signs that session token; set it to any long random string.
# ---------------------------------------------------------------------------
SESSION_JWT_SECRET=
SESSION_TTL_SECONDS=604800

# ---------------------------------------------------------------------------
# Engine — Stockfish (ADR-0004)
# ENGINE_THREADS is 1 deliberately. Multi-threaded Stockfish is not reproducible across
# runs, and Phase 5 requires identical classifications on repeated runs. Parallelism
# comes from running several games at once, not several threads per position.
# ---------------------------------------------------------------------------
STOCKFISH_PATH=/usr/local/bin/stockfish
ENGINE_DEPTH=12
ENGINE_DEEP_DEPTH=18
ENGINE_THREADS=1
ENGINE_HASH_MB=128
ENGINE_TIMEOUT_S=30
# How many games' analysis jobs run concurrently in the background (Phase 5).
ENGINE_MAX_CONCURRENT_GAMES=4

# Move classification thresholds, in centipawns.
INACCURACY_CP=50
MISTAKE_CP=100
BLUNDER_CP=300
# Eval swing above which a position is re-analysed at ENGINE_DEEP_DEPTH.
CRITICAL_SWING_CP=150

# ---------------------------------------------------------------------------
# Pattern intelligence — opening lookup, tactical motifs, strategic themes
# (Phase 6, D-011/D-012, ADR-0009).
#
# OPENINGS_DATA_DIR is resolved relative to the backend package root, same as
# DATABASE_URL's file resolution. The loader reads "<dir>/all.tsv" specifically — see
# data/openings/PROVENANCE.md for why that file (not the five per-volume ones) is the
# validated, cross-volume-deduplicated source of truth.
# ---------------------------------------------------------------------------
OPENINGS_DATA_DIR=data/openings/dist

MOTIF_HANGING_PIECE_MIN_VALUE_CP=300
MOTIF_FORK_MIN_TARGET_VALUE_CP=300

THEME_OPENING_PHASE_PLY_CUTOFF=20
THEME_BAD_BISHOP_MIN_FIXED_PAWNS=3
THEME_PASSED_PAWN_PERSIST_PLIES=4
THEME_PIECE_ACTIVITY_WINDOW_PLIES=10
THEME_SPACE_ADVANTAGE_MIN_RANK_DIFFERENTIAL=2
THEME_TIME_TROUBLE_CLOCK_MS_THRESHOLD=30000
THEME_TIME_TROUBLE_ACCURACY_DROP_PCT=20.0

# Findings below this confidence are computed but not persisted. 0.0 stores everything.
PATTERN_MIN_CONFIDENCE_TO_PERSIST=0.0

# ---------------------------------------------------------------------------
# LLM (ADR-0006)
# ---------------------------------------------------------------------------
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o-mini
OPENAI_API_KEY=
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=2000
LLM_REQUEST_TIMEOUT_S=60
# Hard daily ceiling across all LLM completion calls (Phase 9, D-022 — Q-4 resolved: the
# owner asked for enforcement once Phase 9 made the first real completion spend).
# 500,000 tokens/day is a generous MVP starting point for gpt-4o-mini — worst case a few
# tens of cents/day at current pricing — not a load-tested production figure. Leave blank
# for no ceiling.
LLM_DAILY_TOKEN_CEILING=500000

# ---------------------------------------------------------------------------
# Retrieval (Phase 7, ADR-0008)
# ---------------------------------------------------------------------------
EMBED_MODEL=text-embedding-3-small
EMBED_DIMENSIONS=1536
CHUNK_SIZE_TOKENS=512
CHUNK_OVERLAP_TOKENS=64
RETRIEVAL_TOP_K=8
RETRIEVAL_FUSION_K=60
RETRIEVAL_MIN_SCORE=0.0
# Resolved relative to the backend package root, same convention as OPENINGS_DATA_DIR.
CORPUS_DATA_DIR=data/corpus
# BM25 (Okapi) sparse-retrieval parameters — standard textbook defaults.
RETRIEVAL_BM25_K1=1.5
RETRIEVAL_BM25_B=0.75

# ---------------------------------------------------------------------------
# Profile analytics — multi-game aggregation (Phase 8)
# ---------------------------------------------------------------------------
ANALYTICS_WINDOW_SIZES=10,30,60
ANALYTICS_DEFAULT_WINDOW=10
# Below this many analyzed games in a window, trends/weaknesses are computed but flagged
# as not-yet-confident rather than asserted.
ANALYTICS_MIN_GAMES_FOR_TREND=5
# Share of a window's games a motif/theme must appear in (on the player's own side, at a
# mistake-or-worse ply) to count as a recurring weakness.
ANALYTICS_WEAKNESS_MIN_OCCURRENCE_RATE=0.3
# Estimated-game-duration thresholds (seconds) bucketing a game's TimeControl header into
# bullet/blitz/rapid/classical — "base + 40 * increment", same convention Lichess uses.
TIME_CONTROL_BULLET_MAX_S=180
TIME_CONTROL_BLITZ_MAX_S=480
TIME_CONTROL_RAPID_MAX_S=1500

# ---------------------------------------------------------------------------
# Persona report generation (Phase 9, persona-matrix.md)
# ---------------------------------------------------------------------------
REPORT_SELF_LEARNER_MAX_FINDINGS=5
# Phase 16a addendum: self-learner's fixed "what went well" / "mistakes" split (see
# domain/reports/selection.py) — coach and kid are unaffected by this format change.
REPORT_SELF_LEARNER_POSITIVE_MAX=2
REPORT_SELF_LEARNER_MISTAKE_MAX=3
# Phase 16b: full game-story report's total finding cap (opening/middlegame/endgame/
# lesson combined).
REPORT_STORY_MAX_FINDINGS=6
REPORT_KID_MAX_FINDINGS=3
# Below this confidence, a finding is suppressed entirely for the kid persona rather
# than shown in softened form — see persona-matrix.md's safety rules.
REPORT_KID_MIN_CONFIDENCE_TO_SHOW=0.6
# Training plans (Phase 15, D-032): retrieved knowledge chunks kept per weakness.
REPORT_TRAINING_CHUNKS_PER_WEAKNESS=2

# ---------------------------------------------------------------------------
# Agents (Phase 10+). Ceilings are hard limits.
# ---------------------------------------------------------------------------
AGENT_MAX_STEPS=8
AGENT_MAX_TOOL_CALLS=12
AGENT_TOKEN_BUDGET=20000

# Multi-agent supervisor graph (Phase 13, D-029). Separate, larger ceilings than the
# single-agent settings above — the supervisor graph spends this budget across up to
# five agents (supervisor + retriever + chess analyst + coach + critic) in one turn,
# not one. See MultiAgentSettings' docstring for the sizing rationale.
MULTI_AGENT_MAX_STEPS=20
MULTI_AGENT_MAX_TOOL_CALLS=20
MULTI_AGENT_TOKEN_BUDGET=60000

# ---------------------------------------------------------------------------
# Long-term memory (Phase 11, ADR-0005, D-013, D-026)
# ---------------------------------------------------------------------------
# Below this confidence, a candidate preference/goal/recurring-finding is not written to
# long-term memory at all — the entire enforcement mechanism for "only durable facts
# persist" (writes are silent and confidence-gated, not confirmation-prompted; D-026).
MEMORY_WRITE_CONFIDENCE_FLOOR=0.7

# ---------------------------------------------------------------------------
# Ingestion
# ---------------------------------------------------------------------------
MAX_PGN_UPLOAD_MB=10
MAX_GAMES_PER_IMPORT=60
LICHESS_RATE_LIMIT_RPS=1.0
CHESSCOM_RATE_LIMIT_RPS=1.0

# ---------------------------------------------------------------------------
# Developer insight tracing (ADR-0013)
#
# Records request traces in an in-memory ring buffer, read via /api/v1/dev/traces.
# Recording never calls a model and never runs a tokenizer — token counts come from the
# provider's own response. Cost is a list append per span.
#
# Both switches are forced OFF in production regardless of what is set here: the routes
# are unauthenticated until Phase 2, and prompt text can contain a user's game history.
# ---------------------------------------------------------------------------
DEV_INSIGHT_ENABLED=true
# Captures prompt and retrieved-context TEXT. Off by default everywhere. Turn on only
# when actively debugging prompt construction locally.
DEV_INSIGHT_CAPTURE_PROMPTS=false
DEV_INSIGHT_MAX_TRACES=50
DEV_INSIGHT_MAX_SPANS_PER_TRACE=200

# ---------------------------------------------------------------------------
# Evaluation thresholds (see final_docs/v2/evaluation-strategy.md)
# ---------------------------------------------------------------------------
RAGAS_FAITHFULNESS_THRESHOLD=0.85
RAGAS_ANSWER_ACCURACY_THRESHOLD=0.80
RAGAS_CONTEXT_PRECISION_THRESHOLD=0.75
RAGAS_CONTEXT_RECALL_THRESHOLD=0.75
EVAL_RUN_DIR=evals/runs
# Score ledger (Phase 16): flag a run-over-run drop bigger than this, even if the
# absolute score still clears its own threshold.
EVAL_REGRESSION_TOLERANCE=0.05
# Move-classifier accuracy eval (Phase 16, D-033): independent ground-truth depth and
# sample size for the deep-engine re-analysis pass.
CLASSIFIER_EVAL_GROUND_TRUTH_DEPTH=24
CLASSIFIER_EVAL_SAMPLE_SIZE=24

# ---------------------------------------------------------------------------
# Observability (Phase 17, ADR-0017, D-033)
# ---------------------------------------------------------------------------
LANGSMITH_TRACING=false
# LANGSMITH_API_KEY=
LANGSMITH_PROJECT=grandmate-v2
LANGSMITH_SAMPLE_RATE=1.0
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_CAPTURE_PROMPTS=false
RATE_LIMIT_PER_MINUTE=60

# ---------------------------------------------------------------------------
# Agent Configuration (Phase 17 toggle)
# ---------------------------------------------------------------------------
USE_MULTI_AGENT=false

